# Variáveis da entrega. Copie para .env (gitignored) ou rode `make setup`, que gera o .env
# com um REQUEST_STATE_SECRET aleatório. O Makefile carrega o .env e exporta para os processos.
# Sem LLM e sem provedor: o enunciado proíbe LLM no caminho do agente, então não há chaves de API aqui.

# Chave de integridade do requestState (lida por servidor-mcp/servidor.py, chave_request_state()).
# Hex com pelo menos 32 bytes de aleatoriedade. Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Mantenha a mesma entre reinícios do servidor MCP: é ela que faz um requestState emitido
# antes do restart continuar válido depois. NUNCA versione o valor (o repositório é público).
REQUEST_STATE_SECRET=

# Servidor MCP (servidor-mcp/servidor.py). Padrões exigidos pelo validador: 127.0.0.1:7301, endpoint /mcp.
MCP_HOST=127.0.0.1
MCP_PORT=7301

# Agente A2A (agente/agente.py). Padrões exigidos: porta 7300, JSON-RPC em /a2a, card em /.well-known/agent-card.json.
AGENTE_HOST=127.0.0.1
AGENTE_PORT=7300
# URL publicada no Agent Card (supportedInterfaces[].url = AGENTE_URL + /a2a).
AGENTE_URL=http://127.0.0.1:7300
# Onde o agente encontra o servidor MCP (o agente é um cliente MCP via HTTP, outro processo).
MCP_URL=http://localhost:7301/mcp
